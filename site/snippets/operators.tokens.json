{
 "source": "i32 main() {\n    i64 a = 17;\n    i64 b = 5;\n\n    // Aritmetica. Entre enteros, la division descarta la parte decimal.\n    println(\"${a} + ${b} = ${a + b}\");\n    println(\"${a} - ${b} = ${a - b}\");\n    println(\"${a} * ${b} = ${a * b}\");\n    println(\"${a} / ${b} = ${a / b}      (division entera)\");\n    println(\"${a} % ${b} = ${a % b}      (resto)\");\n\n    // Con flotantes, la division conserva los decimales.\n    println(\"17.0 / 5.0 = ${17.0 / 5.0}\");\n\n    // Comparaciones: el resultado es un bool.\n    println(\"a == b -> ${a == b}\");\n    println(\"a >= b -> ${a >= b}\");\n\n    // Logica. && y || no evaluan la derecha si ya saben el resultado.\n    bool si = true;\n    bool no = false;\n    println(\"si && no -> ${si && no}\");\n    println(\"si || no -> ${si || no}\");\n    println(\"!si      -> ${!si}\");\n\n    // Bits: cada operador trabaja sobre la representacion binaria.\n    i64 x = 0b1100;   // 12\n    i64 y = 0b1010;   // 10\n    println(\"x & y  = ${x & y}\");\n    println(\"x | y  = ${x | y}\");\n    println(\"x ^ y  = ${x ^ y}\");\n    println(\"x << 2 = ${x << 2}\");\n    println(\"x >> 2 = ${x >> 2}\");\n\n    // Asignacion compuesta: opera y guarda en la misma variable.\n    i64 c = 10;\n    c += 5;\n    c *= 2;\n    c %= 7;\n    println(\"c tras += 5, *= 2 y %= 7 -> ${c}\");\n\n    // Cast: convertir de forma explicita. Hacia entero, trunca.\n    println(\"(i64) 3.9 = ${(i64) 3.9}\");\n\n    return 0;\n}\n",
 "hash": "cbbfcffeff7e4d16da35fae119856068f15547da94834d5f577ae03a1be2da50",
