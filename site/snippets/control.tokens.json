{
 "source": "i32 main() {\n    // Condicional. Las llaves no son opcionales.\n    i64 nota = 7;\n    if (nota >= 9) {\n        println(\"sobresaliente\");\n    } else if (nota >= 5) {\n        println(\"aprobado\");\n    } else {\n        println(\"suspenso\");\n    }\n\n    // while: comprueba antes de entrar.\n    i64 i = 0;\n    while (i < 3) {\n        println(\"while ${i}\");\n        i = i + 1;\n    }\n\n    // do-while: ejecuta el cuerpo y comprueba despues, asi que siempre corre\n    // al menos una vez.\n    i64 intentos = 0;\n    do {\n        intentos = intentos + 1;\n    } while (intentos < 5);\n    println(\"intentos = ${intentos}\");\n\n    // for clasico: inicializacion, condicion y paso, en la misma linea.\n    for (i64 k = 0; k < 3; k++) {\n        println(\"for ${k}\");\n    }\n\n    // foreach sobre un array: no hay indice de por medio.\n    i64[4] datos = {10, 20, 30, 40};\n    i64 total = 0;\n    for (i64 v : datos) {\n        total = total + v;\n    }\n    println(\"suma = ${total}\");\n\n    // break sale del bucle; continue salta a la siguiente vuelta.\n    for (i64 m = 0; m < 10; m++) {\n        if (m % 2 == 0) { continue; }\n        if (m > 6) { break; }\n        println(\"impar ${m}\");\n    }\n\n    // El ternario elige entre dos valores sin escribir un if.  Se calcula\n    // fuera de la cadena: dentro de ${...} los dos puntos se confunden con el\n    // separador del especificador de formato.\n    i64 a = 9;\n    i64 b = 4;\n    i64 mayor = a > b ? a : b;\n    println(\"mayor = ${mayor}\");\n\n    // match compara el valor contra varias formas. El guion bajo recoge todo\n    // lo que no haya casado antes.\n    i64 codigo = 3;\n    match codigo {\n        case 1 => println(\"aceptado\");\n        case 2 => println(\"pendiente\");\n        case _ => {\n            println(\"desconocido:\");\n            println(\"  codigo = ${codigo}\");\n        }\n    }\n\n    return 0;\n}\n",
 "hash": "7c5c7f47c45af01478cd0d05e52050428eaa381b204fa6b1fdea9d0070b1c9f8",
