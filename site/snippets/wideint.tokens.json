{
 "source": "// Enteros mas anchos que la palabra de la maquina. No son tipos del\n// compilador: viven en std.wideint, escritos en Vesta.\n\nimport std.wideint only u128, u256;\n\ni32 main() {\n    // Los valores limite se piden a la propia biblioteca.\n    u128 tope128 = u128.max();\n    u256 tope256 = u256.max();\n\n    // Interpolar basta: no hay que llamar a nada para imprimirlos.  Hoy salen\n    // como sus limbs en hexadecimal; la representacion en decimal esta\n    // pendiente de implementar.\n    println(\"mayor u128 = ${tope128}\");\n    println(\"mayor u256 = ${tope256}\");\n\n    // Aritmetica normal. Los operadores estan definidos en la biblioteca, no\n    // en el compilador.\n    u128 uno = u128.min();\n    println(\"menor u128 = ${uno}\");\n    println(\"es cero    = ${uno.is_zero()}\");\n\n    // Comparaciones, tambien definidas en la biblioteca.\n    println(\"tope > cero = ${tope128 > uno}\");\n\n    return 0;\n}\n",
 "hash": "4d7aede87949e57e8f9925fc4ac7b23f66fe71052ad44febbc26fa3fc23a302a",
