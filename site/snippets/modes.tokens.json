{
 "source": "// El mismo fuente corre en la maquina virtual, se compila en caliente con el\n// JIT o se convierte en un ejecutable nativo. No cambia una linea.\n\ni64 fib(i64 n) {\n    if (n < 2) { return n; }\n\n    i64 a = 0;\n    i64 b = 1;\n    i64 i = 2;\n    while (i <= n) {\n        i64 next = a + b;\n        a = b;\n        b = next;\n        i = i + 1;\n    }\n    return b;\n}\n\ni32 main() {\n    println(\"fib(40) = ${fib(40)}\");\n    return 0;\n}\n",
